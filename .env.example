# ============================================================
# AI Customer Support Resolution Agent - Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Get a free Gemini API key at: https://aistudio.google.com/apikey
# ============================================================

# --- LLM Provider ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/support_agent.db

# --- Vector Store ---
CHROMA_PERSIST_DIR=./data/chroma

# --- Guardrail Thresholds ---
# Cases below these thresholds can be auto-resolved
AUTO_RESOLVE_CONFIDENCE=0.85
AUTO_RESOLVE_MAX_AMOUNT=2000
# Cases above this amount are always escalated
HUMAN_APPROVAL_MAX_AMOUNT=10000
# Fraud detection: max refund claims in 30 days before flagging
MAX_REFUND_CLAIMS_30_DAYS=3

# --- Server ---
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO

# --- Feature Flags ---
ENABLE_PII_REDACTION=true
ENABLE_INJECTION_DETECTION=true
ENABLE_RERANKER=true
